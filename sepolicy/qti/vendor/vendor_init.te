allow vendor_init proc_sched:file w_file_perms;
allow vendor_init vendor_proc_display:file w_file_perms;

set_prop(vendor_init, system_oplus_project_prop)
set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, bluetooth_finder_prop)
set_prop(vendor_init, vendor_fingerprint_prop)
set_prop(vendor_init, vendor_oplus_touch_prop)
set_prop(vendor_init, vendor_thermal_engine_prop)
set_prop(vendor_init, vendor_dynamic_sensor_prop)

dontaudit vendor_init cgroup:file getattr;
dontaudit vendor_init debugfs_tracing_debug:dir write;
dontaudit vendor_init debugfs_tracing_debug:file write;
